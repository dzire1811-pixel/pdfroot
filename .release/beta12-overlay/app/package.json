{
  "name": "pdfroot-desktop-pro",
  "version": "0.7.0-beta.13",
  "description": "Professional local Windows shortcut engine for PDFRoot tools.",
  "author": "PDFRoot",
  "publisher": "PDFRoot",
  "copyright": "Copyright \u00a9 2026 PDFRoot",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test src/*.test.cjs",
    "pack:win-dir": "electron-builder --win --x64 --dir",
    "pack:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "jimp": "1.6.0",
    "jszip": "3.10.1",
    "node-machine-id": "^1.1.12",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.0.227"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pdfroot.desktop.pro",
    "productName": "PDFRoot Desktop Pro",
    "artifactName": "PDFRoot-Desktop-Pro-Setup-v${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dzire1811-pixel",
        "repo": "pdfroot",
        "channel": "beta",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/context-icons",
        "to": "context-icons",
        "filter": [
          "**/*.ico"
        ]
      },
      {
        "from": "resources/license-public-key.pem",
        "to": "license-public-key.pem"
      },
      {
        "from": "resources/payment-api.json",
        "to": "payment-api.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFRoot Desktop Pro",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}

